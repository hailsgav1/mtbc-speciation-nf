// Container profile: every process runs from the pipeline's own image
// (biowizardhailey/mtbc-speciation-nf, built + pushed by GitHub Actions),
// pulled and run via Apptainer/Singularity. TB-Profiler keeps its own
// specialised image; RD-Analyzer (legacy) is not containerised.
//
// Status: image builds and runs on HPC; a clean (non-resume) validation run
// to confirm calls match the conda profile is still pending.

conda.enabled = true   // retained only for the legacy RD_ANALYZER fallback

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "${projectDir}/../.apptainer_cache"
}

process {
    executor  = 'local'

    // default: run every process from the pipeline's own container
    container = 'docker://biowizardhailey/mtbc-speciation-nf:latest'

    withName: 'RD_ANALYZER' {
        container = null
        conda     = "${System.getenv('HOME')}/.conda/envs/rd-analyzer-env"
    }

    withName: 'TBPROFILER' {
        container = 'https://depot.galaxyproject.org/singularity/tb-profiler:6.6.6--pyhdfd78af_0'
    }
}
