// Local / HPC execution.
//   * most processes  -> biowizardhailey/mtbc-speciation-nf container (default)
//   * TBPROFILER      -> its own Galaxy/BioContainers image (bundled DB + Java + snpEff)
//   * RD_ANALYZER     -> legacy Python-2 conda env (comparison only; not built into the image)
// Conda remains enabled as a fallback for RD_ANALYZER.

conda.enabled = true

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "${projectDir}/../.apptainer_cache"
}

process {
    executor  = 'local'

    // default: run every process from the pipeline's own container
    container = 'docker://biowizardhailey/mtbc-speciation-nf:latest'

    withName: 'RD_ANALYZER' {
        // legacy tool not in the image; falls back to its conda env
        container = null
        conda     = "${System.getenv('HOME')}/.conda/envs/rd-analyzer-env"
    }

    withName: 'TBPROFILER' {
        container = 'https://depot.galaxyproject.org/singularity/tb-profiler:6.6.6--pyhdfd78af_0'
    }
}
